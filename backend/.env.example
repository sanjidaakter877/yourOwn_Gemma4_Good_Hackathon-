OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Gemini API — primary AI provider (fast, works on mobile, natural responses)
# Get a free key at https://aistudio.google.com/apikey
# Model options: gemini-2.0-flash (default), gemini-1.5-flash, gemini-2.0-flash-lite
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional voice provider. Leave blank unless you use ElevenLabs.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional emotion recognition provider. Leave blank unless you use Hume.
HUME_API_KEY=

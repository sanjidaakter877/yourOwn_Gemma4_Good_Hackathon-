# ── Gemma 4 — Primary AI (required) ─────────────────────────────────────────
# Get a free key at https://aistudio.google.com/apikey
# This key powers both gemma-4-26b-a4b-it (primary) and Gemini (fallback)
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-26b-a4b-it
GEMMA_API_MODEL=gemma-4-e4b-it

# ── Ollama — Local Gemma 4 fallback (optional, privacy-first) ────────────────
# Install Ollama at https://ollama.com and run: ollama pull gemma4:e2b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b

# ── Supabase — Episodic memory & people photos (required for memory feature) ─
# Create a free project at https://supabase.com
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── ElevenLabs — Voice output (optional) ─────────────────────────────────────
# Get a key at https://elevenlabs.io
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Hume — Emotion recognition (optional) ────────────────────────────────────
# Get a key at https://hume.ai
HUME_API_KEY=

#for alerts
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

